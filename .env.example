# Copy this file to `.env` and fill in your values.

# --- Telegram alerts (free) -------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} number.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live market data (free tier: 800 requests/day) -------------------
# Sign up at https://twelvedata.com -> free API key.
# Leave empty to fall back to Yahoo Finance gold futures (GC=F).
TWELVEDATA_API_KEY=

# --- Engine ------------------------------------------------------------
SCAN_INTERVAL_SECONDS=900
# Optional: TradingView webhook receiver (tv_webhook.py). Set a random password.
TV_WEBHOOK_SECRET=
TV_WEBHOOK_PORT=8899

# Optional: Claude-powered news analyst (engine/llm_news.py).
# Add your Anthropic API key to upgrade news scoring from keyword-lexicon to
# real Claude reasoning. Uses your API credits (~a fraction of a cent per call
# on Haiku). Leave blank to keep the free lexicon scorer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
